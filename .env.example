# Environment Variables Reference
# Copy this file to .env and fill in real values.
# Add all of these as environment variables in Vercel / Netlify dashboard.

# Supabase — server-side (not VITE_ prefixed = not exposed to browser bundle)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Supabase — client-side (VITE_ prefix makes them available to the React bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini API key (from https://aistudio.google.com/apikey — free tier)
# Used by /api/chat (Gemini 2.5 Flash via OpenAI-compatible endpoint)
# and /api/tts (Gemini 2.5 Flash Preview TTS via native generateContent endpoint)
GEMINI_API_KEY=
